import socket
from utils.mail import send_email

form_dict = dict(form)
email_sent = form_dict.get('email_sent', None)

def show_update_barcode(barcode, barcodeinfo):
    """This draws a form that will display barcode info, send reminding email to participant,
    and log necessary details for the barcode"""
    div_id = message = email_type = ""
    # req.write(str(barcodeinfo))
    # req.write(str(len(barcodeinfo)))
    if len(barcodeinfo) == 0 or \
       (barcodeinfo[6] == 'n' and barcodeinfo[0] == None):
        #not verified not assigned
        div_id = "not_verified"
        message = "NOT verified"
        email_type = "1"
    elif barcodeinfo[6] == 'y' and barcodeinfo[0] != None:
        #verified and assigned
        div_id = "verified"
        message = "The sample is verified and assigned"
        email_type = "2"
    elif barcodeinfo[6] == 'y' and barcodeinfo[0] == None:
        #verified but not assigned
        div_id = "not_assigned"
        message = "verified but NOT assigned"
        email_type = "3"

    req.write('''
    <div id="{div_id}" class="verification_color">
       <div class="verification_text_wrapper">
          <br />
            <h2 class="verification_text">Barcode <br>
            {barcode}
            <br>{message}</h2>
        </div>
    </div>
    <div id="barcode_form">
    <form action="fusebox.psp?page=barcode_util.psp" method="post"
     onsubmit="return confirm('Are you sure to submit and update database?')"
     onreset="return confirm('Are you sure to reset?')">
      <ul>
         <li>
           <p> Sample issues (inside parentheses are current status): <br />
              <input type="checkbox" name="sample_issue" value="moldy" /> moldy ({moldy}) <br />
              <input type="checkbox" name="sample_issue" value="overloaded" /> overloaded ({overloaded}) <br />
              <input type="checkbox" name="sample_issue" value="other" /> other ({other}) <br />
           </p>
         </li>
         <li>
           <p> Other notes: <br />
              <input type="text" name="other_text" value="{other_text}"
               onblur="if(this.value == '') {{this.value='{other_text}'}}"
               onfocus="if (this.value == '{other_text}') {{this.value=''}}" />
           </p>
         </li>
         <li>
           <p> Sample postmark date: <br />
              <input type="text" name="postmark_date" value="2012-12-25"
               onblur="if(this.value == '') {{this.value='2012-12-25'}}"
               onfocus="if (this.value == '2012-12-25') {{this.value=''}}" />
         </li>
         <li>
           <p> Send a reminder: <br />
              <input type="checkbox" name="send_email" value="send_email" /> send participant an email (previously sent: {sent}) <br />
              <input type="hidden" name="email_type" value="{email_type}">
           </p>
         </li>
      </ul>
       <p>
          <input type="submit" value="Submit">
          <input type="reset" value="Reset!">
       </p>
    </form>
    </div>
    '''.format(div_id=div_id,
               barcode=barcode,
               message=message,
               moldy=barcodeinfo[8],
               overloaded=barcodeinfo[9],
               other=barcodeinfo[10],
               other_text=barcodeinfo[11],
               sent=barcodeinfo[12],
               email_type=email_type))
# deindent
%>

<div>
<form name="check_barcode" action="fusebox.psp?page=barcode_util.psp" method="post">
    <input id="barcode" name="barcode" tabindex="1" type="text"/>
    <input tabindex="2" type="submit" value="Check Barcode" />
    <script>
        document.check_barcode.barcode.focus()
    </script>
</form>
</div>

<%
try:
    barcode = form['barcode'] #'000002000'
    try:
        barcodeinfo = ag_data_access.checkBarcode(barcode)
        # Assuming we actually get barcode details back, log the fact that the barcode
        # was scanned.
        #data_access.updateBarcodeStatus('Received', barcode)
    except(IndexError):
        barcodeinfo = []
    show_update_barcode(barcode, barcodeinfo)

except(KeyError):
    #will get here on first load of this page since there should be no barcode key in the form dict
%>
